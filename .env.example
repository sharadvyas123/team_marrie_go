NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
ACCESSMAP_API_URL=http://127.0.0.1:3001
APP_VERSION=0.1.0
AUTH_SECRET=<at-least-32-character-local-secret>
QR_SIGNING_SECRET=<at-least-32-character-qr-secret>
WEBHOOK_SECRET_ENCRYPTION_KEY=<at-least-16-character-webhook-secret-key>

# Replace every angle-bracket placeholder locally. Do not commit real credentials.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
REDIS_URL=redis://<user>:<password>@localhost:6379
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_PRIVATE=<private-bucket>
STORAGE_BUCKET_PUBLIC=<public-bucket>
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/<public-bucket>
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_UPLOAD_TTL_MS=900000
WEBHOOK_SECRET_ENCRYPTION_KEY=<at-least-16-character-encryption-key>
CIVIC_API_KEY_REQUIRED=false
MAILPIT_SMTP_URL=smtp://localhost:1025

# Worker runtime
WORKER_DATABASE_POOL_SIZE=5
OUTBOX_STREAM=accessmap:events
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=5
