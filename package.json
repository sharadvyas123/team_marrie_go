{
  "name": "accessmap",
  "version": "0.1.0",
  "private": true,
  "description": "Community-verified accessibility information for public spaces.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers"
  ],
  "scripts": {
    "api": "node apps/api/src/server.mjs",
    "worker": "npm run start --workspace @accessmap/workers",
    "dev:api": "node --watch apps/api/src/server.mjs",
    "dev": "npm run dev --workspace @accessmap/web",
    "lint:web": "npm run lint --workspace @accessmap/web",
    "build:web": "npm run build --workspace @accessmap/web",
    "check:health": "node scripts/health-check.mjs",
    "lint": "node scripts/lint.mjs && npm run lint:web",
    "test": "node --test",
    "build": "node scripts/build.mjs && npm run build:web",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  }
}
